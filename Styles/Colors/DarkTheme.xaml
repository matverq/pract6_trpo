<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="Black"/>
    <SolidColorBrush x:Key="TextFg" Color="White"/>
    <SolidColorBrush x:Key="InputBg" Color="DimGray"/>

    <SolidColorBrush x:Key="PrimaryBackground" Color="RoyalBlue"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="DeepSkyBlue"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="Gray"/>
    <SolidColorBrush x:Key="SecondaryHover" Color="DarkGray"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="White"/>
    <SolidColorBrush x:Key="DangerBackground" Color="DarkRed"/>
    <SolidColorBrush x:Key="DangerHover" Color="Red"/>
    <SolidColorBrush x:Key="DangerForeground" Color="White"/>
    <SolidColorBrush x:Key="DisabledBackground" Color="DimGray"/>
    <SolidColorBrush x:Key="DisabledForeground" Color="Gray"/>
</ResourceDictionary>